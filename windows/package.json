{
  "name": "compositor-windows",
  "version": "1.3.3",
  "description": "Compositor for Windows - The lightweight, focused Photoshop alternative",
  "main": "src/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaksVolkov7863/Compositor-Community-Edition-on-Windows.git"
  },
  "scripts": {
    "test": "node --test",
    "parity": "node ../scripts/parity-audit.js",
    "benchmark": "node ../scripts/benchmark-pipeline.js",
    "start": "electron src/main.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --x64 --publish never",
    "smoke": "electron tests/electron-smoke.js"
  },
  "keywords": [
    "compositor",
    "image-editor",
    "photoshop-alternative",
    "windows",
    "graphics"
  ],
  "author": "MaksVolkov7863",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "libheif-js": "^1.23.5",
    "utif": "^3.1.0"
  },
  "build": {
    "appId": "com.compositor.windows",
    "productName": "Compositor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Compositor"
    }
  }
}
