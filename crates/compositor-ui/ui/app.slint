import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Compositor Native (Windows)";
    preferred-width: 1200px;
    preferred-height: 800px;
    background: #1e1e1e;

    VerticalBox {
        // Top Toolbar
        HorizontalBox {
            height: 48px;
            padding: 8px;
            Text {
                text: "Compositor 1.3.3 [Rust + Slint Native]";
                color: #ffffff;
                font-size: 14px;
                vertical-alignment: center;
            }
        }

        // Main Editor Layout
        HorizontalBox {
            // Tools Panel
            Rectangle {
                width: 52px;
                background: #252526;
                border-radius: 4px;
            }

            // Canvas Viewport Area
            Rectangle {
                background: #181818;
                border-width: 1px;
                border-color: #333333;
                Text {
                    text: "Hardware-Accelerated Canvas (wgpu / DirectX 12)";
                    color: #888888;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Right Inspector & Layers Panel
            Rectangle {
                width: 260px;
                background: #252526;
                border-radius: 4px;
                VerticalBox {
                    padding: 8px;
                    Text {
                        text: "Layers";
                        color: #ffffff;
                        font-weight: 700;
                    }
                }
            }
        }
    }
}
